[Unit]
Description=Threadangle FastAPI backend
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/threadangle/backend
Environment="PATH=/var/www/threadangle/backend/venv/bin"
ExecStart=/var/www/threadangle/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010 --workers 1
Restart=on-failure
RestartSec=5
MemoryMax=450M
CPUQuota=60%
TasksMax=80

[Install]
WantedBy=multi-user.target
